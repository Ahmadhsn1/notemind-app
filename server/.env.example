# Validated at boot by config/env.js — the server exits with a readable
# message rather than starting in a broken state. See DEPLOY.md.

NODE_ENV=development
PORT=5000

# --- Required everywhere ---
MONGO_URI=mongodb://localhost:27017/notemind
# Minimum 16 chars in development, 32 in production.
# Generate one with: openssl rand -base64 48
# Changing this invalidates every issued token (logs all users out).
JWT_SECRET=replace-with-a-long-random-string

# --- Required in production ---
# Comma-separated list of allowed browser origins, used for both REST CORS and
# the Socket.IO handshake. Defaults to the Vite dev server in development; in
# production the server refuses to boot without it, because the old localhost
# fallback meant a deploy that forgot it blocked every request via CORS with
# nothing at all in the logs.
CLIENT_URL=http://localhost:5173

# --- AI (optional; features degrade gracefully if absent) ---
GEMINI_API_KEY=your-gemini-api-key
# To use more than one key (spreads load and rotates away from any key that
# hits its quota — see services/geminiKeyPool.js), set this instead,
# comma-separated; GEMINI_API_KEY above is then ignored. Note that keys from
# the same Google Cloud project usually share one quota bucket — only keys
# from genuinely separate projects give additive quota.
# GEMINI_API_KEYS=key-one,key-two,key-three
# Per-user, per-UTC-day cap on billed Gemini calls (default 200).
# DAILY_AI_CALL_LIMIT=200

# --- Image uploads: Cloudflare R2 (S3-compatible) ---
# All four together, or none at all. REQUIRED in production: local-disk
# uploads are wiped on every deploy on a container platform, silently turning
# every image any user ever pasted into a broken <img>. Unset in development
# falls back to local disk. Migrate existing files with
# scripts/migrate-uploads-to-r2.js.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Google Sign-In (optional) ---
# Same Client ID as client/.env's VITE_GOOGLE_CLIENT_ID. Verifies Google ID
# tokens on POST /api/auth/google; that route 501s if this is unset.
GOOGLE_CLIENT_ID=

# --- Transactional email: pick ONE backend ---
# Neither set = reset links are written to the server log instead of emailed.
# Fine for development; a real user would have no way to receive one.
# A half-configured backend refuses to boot rather than silently degrading.

# Option A — Gmail. No domain needed, ~500 emails/day.
# GMAIL_APP_PASSWORD is a Google App Password, NOT your account password:
#   Google Account > Security > 2-Step Verification (must be on)
#     > App passwords > create one
# Google shows it as four groups with spaces; pasting it verbatim is fine,
# the spaces are stripped automatically.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B — Resend. Needs a domain you own and have verified by DNS; you
# cannot verify gmail.com. Preferred once you have one: better deliverability
# and a real from-address. Takes precedence over Gmail if both are set.
RESEND_API_KEY=
# e.g. NoteMind <noreply@yourdomain.com>
EMAIL_FROM=

# --- Observability (optional) ---
SENTRY_DSN=
# fatal | error | warn | info | debug | trace | silent  (default: info)
LOG_LEVEL=
