PORT=5000
MONGO_URI=mongodb://localhost:27017/notemind
JWT_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key
# To use more than one key (spreads load across keys and automatically
# rotates away from any key that hits its quota — see services/geminiKeyPool.js),
# set this instead, comma-separated, and GEMINI_API_KEY above is ignored:
# GEMINI_API_KEYS=key-one,key-two,key-three

# Comma-separated list of allowed CORS origins. Defaults to the Vite dev
# server (http://localhost:5173) if unset.
CLIENT_URL=http://localhost:5173

# Optional — same Client ID as client/.env's VITE_GOOGLE_CLIENT_ID. Verifies
# Google ID tokens on POST /api/auth/google; that route 501s if this is unset.
GOOGLE_CLIENT_ID=
